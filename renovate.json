{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mairie360/renovate-config"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": true,
  "minimumReleaseAge": null,
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "packageRules": [
    {
      "description": "TEMPLATE UNIQUEMENT : tout est automergé (majeures, 0.x, Dockerfile de prod), même si la CI échoue. À remplacer dans une vraie API (voir README, étape 3)",
      "matchPackageNames": [
        "*"
      ],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "cicd.yml, promote-staging.yml and promote-prod.yml pin the same CICD release: bump them in one PR (MAIR-494).",
      "matchPackageNames": [
        "mairie360/CICD"
      ],
      "groupName": "mairie360/CICD"
    }
  ],
  "lockFileMaintenance": {
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(cicd|promote-staging|promote-prod)\\.yml$/"
      ],
      "matchStrings": [
        "cicd_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "mairie360/CICD",
      "datasourceTemplate": "github-tags"
    }
  ]
}
