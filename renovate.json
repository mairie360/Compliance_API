{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mairie360/renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "cicd.yml, promote-staging.yml and promote-prod.yml each reference the reusable workflow twice (`uses:` and the `cicd_version` input): bump them all in one PR (MAIR-427, MAIR-494).",
      "matchPackageNames": [
        "mairie360/CICD"
      ],
      "groupName": "mairie360/CICD"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(cicd|promote-staging|promote-prod)\\.yml$/"
      ],
      "matchStrings": [
        "cicd_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "mairie360/CICD",
      "datasourceTemplate": "github-tags"
    }
  ]
}
