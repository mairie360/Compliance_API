{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mairie360/renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "The reusable workflow is referenced twice in cicd.yml (`uses:` pinned by commit, and the `cicd_version` input): bump both in one PR (MAIR-427).",
      "matchPackageNames": [
        "mairie360/CICD"
      ],
      "groupName": "mairie360/CICD"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/cicd\\.yml$/"
      ],
      "matchStrings": [
        "cicd_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "mairie360/CICD",
      "datasourceTemplate": "github-tags"
    }
  ]
}
